<Page x:Class="LoginClient.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Welcome" FontSize="32" FontWeight="Bold"
                   HorizontalAlignment="Center" />

        <StackPanel Grid.Row="1" Margin="0,32,0,0" HorizontalAlignment="Center" Width="280">
            <Button Content="Read File / Image" Height="48" Margin="0,0,0,12" Click="ReadFileButton_Click" />
            <Button Content="Audio Transcription" Height="48" Margin="0,0,0,12" Click="AudioTranscriptionButton_Click" />
            <Button Content="Logout" Height="48" Click="LogoutButton_Click" />
        </StackPanel>
    </Grid>
</Page>
